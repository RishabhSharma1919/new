generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String        @id @default(cuid())
  name       String
  avatar     String
  color      String
  createdAt  DateTime      @default(now())
  boardLinks BoardMember[]
  cardLinks  CardMember[]
}

model Board {
  id         String        @id @default(cuid())
  title      String
  background String        @default("ocean")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  lists      BoardList[]
  labels     Label[]
  members    BoardMember[]
}

model BoardMember {
  boardId String
  userId  String
  role    String     @default("member")
  board   Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
  @@index([userId])
}

model BoardList {
  id         String   @id @default(cuid())
  boardId    String
  title      String
  position   Int
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  board      Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards      Card[]

  @@index([boardId, position])
  @@map("lists")
}

model Card {
  id          String       @id @default(cuid())
  listId      String
  title       String
  description String       @default("")
  coverImage  String?
  dueDate     DateTime?
  position    Int
  isArchived  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  list        BoardList    @relation(fields: [listId], references: [id], onDelete: Cascade)
  labels      CardLabel[]
  members     CardMember[]
  checklists  Checklist[]
  activities  Activity[]
  attachments Attachment[]
  comments    Comment[]

  @@index([listId, position])
}

model Label {
  id      String      @id @default(cuid())
  boardId String
  name    String
  color   String
  board   Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards   CardLabel[]
}

model CardLabel {
  cardId  String
  labelId String
  card    Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label   Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
}

model CardMember {
  cardId String
  userId String
  card   Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
  @@index([userId])
}

model Checklist {
  id        String          @id @default(cuid())
  cardId    String
  title     String          @default("Checklist")
  position  Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  card      Card            @relation(fields: [cardId], references: [id], onDelete: Cascade)
  items     ChecklistItem[]

  @@index([cardId, position])
}

model ChecklistItem {
  id          String    @id @default(cuid())
  checklistId String
  title       String
  isComplete  Boolean   @default(false)
  position    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId, position])
}

model Activity {
  id        String   @id @default(cuid())
  cardId    String
  action    String
  message   String
  actorName String?
  createdAt DateTime @default(now())
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
}

model Attachment {
  id        String   @id @default(cuid())
  cardId    String
  name      String
  fileUrl   String
  mimeType  String
  sizeBytes Int
  actorName String?
  createdAt DateTime @default(now())
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  cardId    String
  message   String
  actorName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
}
